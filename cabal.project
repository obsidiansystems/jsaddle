packages:
 jsaddle/

if !impl(ghcjs)
  packages:
   jsaddle-warp/
   jsaddle-wkwebview/
   jsaddle-webkit2gtk/
   jsaddle-clib/

constraints: haskell-gi-overloading == 0.0

-- This is necessary as the JSString patch of hashable is only applicable to versions < 1.4
if impl(ghcjs)
  constraints: hashable < 1.4

allow-newer: websockets:random, splitmix:time, *:time, *:unix, *:process, stm:base
